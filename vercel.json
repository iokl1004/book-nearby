{
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/book/:isbn",
      "destination": "/api/share?isbn=:isbn"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
